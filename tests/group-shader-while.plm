// expect: ok
// A group's shader only while something holds: with the waves still, the group is painted as it is, without a pass of its own.
scene GroupShaderWhile {
    surface { size: 200, 100 }
    shader wet = file "shaders/wet.wgsl"
    fact raining = false
    prop k = 0 ~calm
    follow k = if(raining, 1, 0)
    group {
        shader: wet, k while k > 0.001
        box { from: 10, 10; size: 180, 80; corner: 10; color: #9ed6bd }
    }
}
