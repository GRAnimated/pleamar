// The dialog that asks for the password when a program wants to do something
// as root —mounting a disk, a system tool, `pkexec`—. While this scene runs it
// is the session's polkit agent: polkit says what is wanted and whose password
// it takes, and the answer goes to polkit's own helper, which is the one that
// checks it. Try it: run this, and `pkexec true` in a terminal.
//
// What is seen comes from the service, with no logic; the logic only carries
// the answer.
language 0.4
import "common/palette.plm"

scene Password {
    surface { size: 540, 346; anchor: center; level: overlay; keyboard: exclusive while auth.pending }
    permissions { services: "polkit", "polkit.*" }

    service polkit as auth {
        pending: bool
        asking: bool
        message: text
        user: text
        prompt: text
        info: text
        error: none | wrong
    }

    text answer = ""
    event send ->                           // to the logic: answer with what was typed
    event dismiss ->                        // to the logic: give up

    prop seen = 0 ~quick
    prop rise = 12 ~lively
    layer dialog ~quick {
        shown while auth.pending { seen: 1 ~quick; rise: 0 ~lively }
        gone                     { seen: 0 ~quick; rise: 12 ~quick }
    }

    group {
        opacity: seen
        // Room around the panel for its shadow.
        move: 40, 22 + rise

        body {
            color: coal; rim: 5%; shadow: 0, 18, 50, 45%
            box { from: 10, 10; size: 440, 244; corner: 20 }
        }

        text "Authentication required" { at: 34, 40; anchor: left center; size: 17; weight: 600; color: ink }
        text auth.message { at: 34, 60; width: 392; lines: 3; size: 13; color: ink; opacity: 70% }

        text "{auth.prompt}" { at: 34, 128; anchor: left center; size: 12; color: ink; opacity: 55% }
        text "{auth.user}" { at: 426, 128; anchor: right center; size: 12; color: mint }
        box { from: 34, 142; size: 392, 40; corner: 10; color: #202221 }
        // Whoever sits there types it: an agent at the desktop is not let into this field.
        input answer { at: 48, 152; width: 364; size: 15; color: ink; placeholder: "password"; secret: true; agent: no; label: "Password" }

        text auth.info { at: 34, 196; anchor: left center; width: 220; lines: 1; size: 12; color: ink; opacity: 60% }
        text "That was not it. Try again." { at: 34, 214; anchor: left center; size: 12; color: sand; show: auth.error == wrong }
        text "Checking…" { at: 34, 214; anchor: left center; size: 12; color: ink; opacity: 60%; show: auth.pending and not auth.asking and auth.error == none }

        box { from: 266, 204; size: 76, 32; corner: 10; color: ink; opacity: 8% + 6% * cancel.hover }
        text "Cancel" { at: 304, 220; anchor: center; size: 13; color: ink }
        box { from: 350, 204; size: 76, 32; corner: 10; color: mint; opacity: 80% + 20% * ok.hover }
        text "OK" { at: 388, 220; anchor: center; size: 13; weight: 600; color: coal }
    }

    zone box cancel { from: 306, 226; size: 76, 32; corner: 10; cursor: pointer; label: "Cancel"; active: auth.pending }
    // Letting a program through is for whoever sits there to do, not for an agent.
    zone box ok { from: 390, 226; size: 76, 32; corner: 10; cursor: pointer; label: "Authenticate"; agent: no; active: auth.pending }

    on change auth.pending { focus answer }
    on change auth.asking  { focus answer }
    on submit answer       { emit send }
    on press ok            { emit send }
    on press cancel        { emit dismiss }
    on key Escape          { emit dismiss }
}
